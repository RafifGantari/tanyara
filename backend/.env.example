# Tanyara Backend Configuration
PROJECT_NAME="Tanyara API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS Configuration
# Comma-separated allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase Configuration
# Server-side privileged Service Role Secret Key (NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Optional: Supabase JWT Secret for direct offline cryptographic validation
# (Found in Supabase Dashboard > Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=

# Google Gemini API
# Server-side AI provider API key (NEVER expose to frontend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
